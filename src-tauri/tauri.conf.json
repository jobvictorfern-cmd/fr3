{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor FR3",
  "version": "0.3.0",
  "identifier": "br.com.siamac.editorfr3",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Editor FR3",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "SIAMAC",
    "category": "Productivity",
    "shortDescription": "Editor de relatorios FastReport",
    "longDescription": "Editor visual de relatorios FastReport (.fr3): abre, edita e salva preservando o arquivo original byte a byte.",
    "fileAssociations": [
      {
        "ext": ["fr3"],
        "name": "Relatorio FastReport",
        "description": "Relatorio FastReport (.fr3)",
        "role": "Editor"
      },
      {
        "ext": ["term"],
        "name": "Ticket FastReport",
        "description": "Relatorio FastReport gravado com extensao .term",
        "role": "Editor"
      },
      {
        "ext": ["rav"],
        "name": "Projeto Rave Reports",
        "description": "Projeto de relatorio Rave Reports (.rav)",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      },
      "wix": {
        "language": ["pt-BR", "en-US"]
      }
    }
  }
}
